# Supabase Configuration
# Obtén estos valores desde tu proyecto en https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nota: El SERVICE_ROLE_KEY es solo para uso en el backend
# NUNCA lo expongas en clientes públicos

# (Opcional) Envío de correos de invitación con Resend (https://resend.com)
# Si no las defines, las invitaciones funcionan compartiendo el enlace manualmente.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=ContaTaller <invitaciones@tudominio.com>

# Administradores de la plataforma (correos separados por coma) — acceso al panel /admin
# Si no la defines, por defecto es josuetejadaromero@gmail.com
# ADMIN_EMAILS=tucorreo@gmail.com,otro@gmail.com

# (Opcional) Contacto de soporte/suscripción que se muestra a los usuarios
# NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tudominio.com
# NEXT_PUBLIC_SUPPORT_WHATSAPP=18095551234
# NEXT_PUBLIC_SUPPORT_PHONE=+1 809 555 1234

# =====================================================================
# Agente de captura por WhatsApp (WhatsApp + IA)
# =====================================================================
# Guía completa: GUIA-EVOLUTION-WHATSAPP.md

# --- IA (Claude) -----------------------------------------------------
# Obtén la llave en https://console.anthropic.com
# Sin ella el agente no interpreta mensajes (responde que no está activo).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# (Opcional) Modelo a usar. Por defecto claude-haiku-4-5 (rápido y económico).
# Para más capacidad: claude-sonnet-5 o claude-opus-4-8
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Número visible del asistente (se muestra en la app) -------------
# Solo dígitos, con código de país.
# NEXT_PUBLIC_WHATSAPP_NUMBER=18095551234

# --- Evolution API (para ENVIAR por WhatsApp de verdad) --------------
# NO son necesarias para probar el agente en local con scripts/wa-chat.mjs:
# sin ellas el agente responde solo en el JSON del webhook (ver el "Atajo" en
# GUIA-EVOLUTION-WHATSAPP.md). Ponlas cuando conectes WhatsApp real.
# EVOLUTION_API_URL=https://wa.tudominio.com
# EVOLUTION_API_KEY=el-hash-de-la-instancia-o-la-llave-global
# EVOLUTION_INSTANCE=jobidai

# (Recomendado) Token secreto que Evolution debe enviar al llamar al webhook.
# Si lo defines, el webhook exige el header x-webhook-token o ?token=
# EVOLUTION_WEBHOOK_TOKEN=inventa-un-token-largo-y-aleatorio

# (Opcional) Zona horaria para interpretar "mañana 3pm". Default America/Santo_Domingo
# WHATSAPP_TZ=America/Santo_Domingo
