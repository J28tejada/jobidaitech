# Supabase Configuration
# Obtén estos valores desde tu proyecto en https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nota: El SERVICE_ROLE_KEY es solo para uso en el backend
# NUNCA lo expongas en clientes públicos

# (Opcional) Envío de correos de invitación con Resend (https://resend.com)
# Si no las defines, las invitaciones funcionan compartiendo el enlace manualmente.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=ContaTaller <invitaciones@tudominio.com>

# Administradores de la plataforma (correos separados por coma) — acceso al panel /admin
# Si no la defines, por defecto es josuetejadaromero@gmail.com
# ADMIN_EMAILS=tucorreo@gmail.com,otro@gmail.com

# (Opcional) Contacto de soporte/suscripción que se muestra a los usuarios
# NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tudominio.com
# NEXT_PUBLIC_SUPPORT_WHATSAPP=18095551234
# NEXT_PUBLIC_SUPPORT_PHONE=+1 809 555 1234
